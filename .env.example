# Settings for the command-line script (script.js). Copy this file to ".env" and fill it in.
# ".env" is git-ignored. Leave everything empty to run the safe local mock (nothing real is touched).
# (The web page has its own settings: UAT_URL and PROD_URL at the top of static/index.html.)

# ---- API address of each environment (address only, no /api/plan/... path). https:// or http:// ----
# Used with:  node script.js --file x.csv --env uat   (or --env prod)
UAT_BASE_URL=
PROD_BASE_URL=

# ---- Real run safety (it creates REAL credentials) ----
# Needed on every real run, together with the --yes-create-real-credentials option:
# ALLOW_REAL_API=yes
