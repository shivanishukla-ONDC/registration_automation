# Settings for registration_automation (server.js and script.js). Copy this file to ".env" and fill it in.
# ".env" is git-ignored; never commit real values. On a server you can set these as real environment
# variables instead of using a file. Leave everything empty to run the safe local mock.

# ---- Server where create-token is called (base URL only, no /api/plan/create-token) ----
# Setting this switches to REAL mode. Must start with https:// or http://
TARGET_BASE_URL=

# ---- Database holding the environment_access table (read-only lookup: subscriber_id -> organisation_id) ----
# Use a read-only DB user. It must belong to the SAME environment as TARGET_BASE_URL.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_DATABASE=
# Optional: true = TLS with certificate check, no-verify = TLS without certificate check
DB_SSL=

# ---- Real mode safety (creates REAL credentials) ----
# ALLOW_REAL_API=yes    required for real mode
# ACCESS_KEY=           required for real mode: the key users type into the page

# ---- Web page (npm start) ----
# PORT=3000
# HOST=127.0.0.1        use 0.0.0.0 so other machines can open the page
# MAX_ROWS=             rows per file (default 20 in real mode, 100 in mock mode)
# LOOKUP_STAGE=         optional: only match environment_access rows with this stage_id
